# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Project artifacts: committed outputs the live API serves; refreshed weekly
# by the model-training workflow's report PR. Trained models stay out entirely:
# the registry resolves "latest" by run-id sort, and a metadata-only stub
# (files gitignored) would shadow real runs whose joblib files don't exist.
artifacts/*
!artifacts/backtest/
!artifacts/forecasts/
!artifacts/portfolios/
!artifacts/reports/

# Downloaded price cache is committed so deployments serve data without
# hitting Yahoo at boot; the weekly retrain PR keeps it current
/reports/
!configs/**/*.yaml

# Environment / secrets
.env
*.key

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
