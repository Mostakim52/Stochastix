# StockForge runtime configuration (copy to .env and adjust)
# All values optional; sensible defaults are baked into configs/default.yaml

# Logging level: DEBUG | INFO | WARNING | ERROR
STOCKFORGE_LOG_LEVEL=INFO

# Where models / forecasts / reports are written
STOCKFORGE_ARTIFACTS_DIR=./artifacts
STOCKFORGE_DATA_CACHE_DIR=./data/cache

# API protection for POST /retrain (leave empty to disable auth)
STOCKFORGE_API_KEY=

# Deployment targets used by CI/CD (never commit real values)
FLY_API_TOKEN=
RENDER_DEPLOY_HOOK_URL=
